# EditorConfig: https://editorconfig.org
# Many editors apply indent/tab settings from this file automatically.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{yml,yaml,json}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
