{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowJs": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": [ "src/*" ],
			"@sr/*": [ "src/ts/*" ]
		}
	},
	"include": [ "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts" ]
}
